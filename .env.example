# ─────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────
# URL publica (usada em metadata, sitemap, robots, JSON-LD e links de partilha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Base de dados (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://mp_user:mp_password@localhost:5432/mercadosportugues

# Quando ausente/false, a app corre com o repositorio em memoria (dados seed / modo demo).
# Define USE_DB=true para usar PostgreSQL (app, scraper e seed).
USE_DB=false
# Tamanho do pool e SSL (ex.: fornecedores geridos exigem PG_SSL=true).
PG_POOL_MAX=10
PG_SSL=false

# ─────────────────────────────────────────────
# Admin
# ─────────────────────────────────────────────
# Token para /admin (dashboard, revisao) e /api/admin/*.
# OBRIGATORIO em producao: sem ele (ou com o placeholder / token curto < 32
# caracteres) a aplicacao RECUSA arrancar. Sem ele em dev, as rotas admin
# respondem 503.
#
# Gerar um token forte (escolhe UM comando):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
# PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
ADMIN_TOKEN=trocar-por-um-token-longo

# ─────────────────────────────────────────────
# API publica (cache/rate limiting best-effort por instancia)
# ─────────────────────────────────────────────
API_CACHE_TTL_SECONDS=60
API_CACHE_MAX_ENTRIES=500
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_GET_MAX=120
API_RATE_LIMIT_POST_MAX=30

# ─────────────────────────────────────────────
# Scraper (npm run scrape)
# ─────────────────────────────────────────────
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_MAX_DELAY_MS=4000
SCRAPER_MAX_RETRIES=4
SCRAPER_TIMEOUT_MS=60000
# true  = nao faz pedidos reais (usa fixtures locais)
# false = pedidos reais as paginas publicas de categoria + API Mercadona
SCRAPER_DRY_RUN=true
# 0 = todas as categorias-folha do sitemap/API. Numero positivo limita cada loja (testes locais).
SCRAPER_MAX_CATEGORIES=0

# Catalogo local quando nao ha PostgreSQL (npm run scrape grava aqui).
LIVE_CATALOG_PATH=data/snapshots/live-catalog.json
