{
  "name": "mercadosportugues",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de comparacao diaria de precos dos supermercados em Portugal",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "tsx src/scrapers/pipeline/run-daily.ts",
    "scrape:continente": "tsx src/scrapers/pipeline/run-daily.ts --only=continente",
    "scrape:pingo-doce": "tsx src/scrapers/pipeline/run-daily.ts --only=pingo-doce",
    "scrape:auchan": "tsx src/scrapers/pipeline/run-daily.ts --only=auchan",
    "scrape:mercadona": "tsx src/scrapers/pipeline/run-daily.ts --only=mercadona",
    "rematch": "tsx src/lib/relink-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed-db.ts",
    "db:check": "tsx src/db/check-db.ts",
    "scrape:verify": "tsx src/scrapers/pipeline/verify-scrape.ts",
    "enrich:eans": "tsx src/scrapers/pipeline/enrich-eans.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "5.8.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3"
  }
}
