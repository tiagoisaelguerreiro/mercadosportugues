# ─────────────────────────────────────────────
# Base de dados (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://mp_user:mp_password@localhost:5432/mercadosportugues

# Quando ausente/curto-circuitado, a app corre com o repositorio em memoria (dados seed).
# Define USE_DB=true para forcar o uso de PostgreSQL.
USE_DB=false

# ─────────────────────────────────────────────
# Scraper
# ─────────────────────────────────────────────
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_MAX_DELAY_MS=4000
SCRAPER_MAX_RETRIES=4
# Modo dry-run nao escreve na base de dados (usa fixtures locais)
SCRAPER_DRY_RUN=true
